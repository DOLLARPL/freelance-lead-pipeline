# Copy to .env and fill in. Nothing here is a real credential.

# --- model access -----------------------------------------------------------
OPENROUTER_API_KEY=

# --- optional: source credentials -------------------------------------------
# Apify token for the Facebook group actor. Leave empty to run only the
# sources that need no credentials (JustJoin.it, Useme, Oferteo mail).
APIFY_TOKEN=

# --- optional: Telegram digest ----------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_THREAD_ID=

# --- optional: web push notifications ---------------------------------------
VAPID_SUBJECT=mailto:you@example.com
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# --- paths and runtime ------------------------------------------------------
# Defaults point at ./data and ./config; override only when you keep state
# outside the repository.
SNAJPER_CACHE_DIR=
SNAJPER_STATE=
SNAJPER_LEDGER=
SNAJPER_WEB_DB=
SNAJPER_REPORTS_DIR=
SNAJPER_CENNIK=
SNAJPER_HOST=127.0.0.1
SNAJPER_PORT=8000
SNAJPER_PUBLIC_HOST=
SNAJPER_OWNER_LOGIN=
SNAJPER_MAX_AGE_HOURS=72
SNAJPER_AUTO_IMPORT=0
# Base URL of the humanizer-pl service, used for style checks on drafts.
SNAJPER_HUMANIZER_URL=http://127.0.0.1:8011
